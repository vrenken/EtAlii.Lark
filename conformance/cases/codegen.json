{"id":"codegen-0000","grammar":"// Purchase orders with order lines, shipping and pricing rules.\n// Used by docs/typed-visitor.md and tested by PurchaseOrderTests.\n\norder: \"order\" TEXT customer \"currency\" CURRENCY line+ [shipping] rule*\n\ncustomer: \"customer\" TEXT [\"(\" TIER \")\"]\n\nline: \"line\" TEXT TEXT \"qty\" COUNT \"at\" AMOUNT [\"discount\" PERCENT]\n\n?shipping: \"ship\" \"standard\" \"to\" address    -> standard_shipping\n         | \"ship\" \"express\" \"to\" address     -> express_shipping\n         | \"pickup\" \"at\" TEXT                -> pickup\n\naddress: TEXT+\n\nrule: \"rule\" \"when\" condition \"then\" action\n\n?condition: conjunction\n          | condition \"or\" conjunction       -> any_of\n?conjunction: test\n            | conjunction \"and\" test         -> all_of\n?test: FIELD OP operand                      -> comparison\n     | \"(\" condition \")\"\n\n?operand: AMOUNT                             -> amount_operand\n        | COUNT                              -> count_operand\n        | TIER                               -> tier_operand\n\n?action: \"discount\" PERCENT                  -> percent_discount\n       | \"free\" \"shipping\"                   -> free_shipping\n       | \"require\" \"approval\" \"by\" TEXT      -> require_approval\n\nFIELD: \"order.total\" | \"line.quantity\" | \"customer.tier\"\nOP: \"<=\" | \">=\" | \"!=\" | \"=\" | \"<\" | \">\"\nTIER: \"gold\" | \"silver\" | \"bronze\"\nCURRENCY: \"EUR\" | \"USD\" | \"GBP\"\nAMOUNT.2: /\\d+\\.\\d\\d/\nPERCENT: /\\d+(\\.\\d+)?%/\n\n%import common.ESCAPED_STRING -> TEXT\n%import common.INT -> COUNT\n%import common.WS\n%ignore WS\n","grammar_file":"../dotnet/docs/examples/PurchaseOrders/purchase-order.lark","options":{"parser":"lalr","start":"order"},"tests":[{"input":"order \"PO-2026-0142\"\ncustomer \"ACME Corp\" (gold)\ncurrency EUR\nline \"LT-14\" \"Laptop 14 inch\" qty 5 at 1299.00\nline \"DS-02\" \"Docking station\" qty 5 at 189.50 discount 10%\nship expres