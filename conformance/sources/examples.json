   "options": {
    "parser": "lalr"
   },
   "inputs": [
    {
     "input": "// The calculator of Lark's examples/calc.py.\n?start: sum\n      | NAME \"=\" sum    -> assign_var\n\n?sum: product\n    | sum \"+\" product   -> add\n    | sum \"-\" product   -> sub\n\n?product: atom\n    | product \"*\" atom  -> mul\n    | product \"/\" atom  -> div\n\n?atom: NUMBER           -> number\n     | \"-\" atom         -> neg\n     | NAME             -> var\n     | \"(\" sum \")\"\n\n%import common.CNAME -> NAME\n%import common.NUMBER\n%import common.WS_INLINE\n\n%ignore WS_INLINE\n"
    },
    {
     "input": "// The JSON grammar of Lark's examples/json_parser.py.\n?start: value\n\n?value: object\n      | array\n      | string\n      | SIGNED_NUMBER      -> number\n      | \"true\"             -> true\n      | \"false\"            -> false\n      | \"null\"             -> null\n\narray  : \"[\" [value (\",\" value)*] \"]\"\nobject : \"{\" [pair (\",\" pair)*] \"}\"\npair   : string \":\" value\n\nstring : ESCAPED_STRING\n\n%import common.ESCAPED_STRING\n%import common.SIGNED_NUMBER\n%import common.WS\n\n%ignore WS\n"
    },
    {
     "input": "// Exercises many grammar features at once: templates, priorities, aliases, inlining, kept tokens,\n// maybe-placeholders, repetition ranges, terminal composition and %declare-free imports.\nstart: statement*\n\n?statement: assignment \";\"\n          | call \";\"\n          | block\n          | \"print\" _list{expr} \";\"     -> print\n\nassignment: NAME \"=\" expr\ncall: NAME \"(\" [_list{expr}] \")\"\nblock: \"{\" statement* \"}\"\n\n_list{item}: item (\",\" item)*\n\n?expr: expr \"or\" and_expr     -> or_\n     | and_expr\n?and_expr: and_expr \"and\" comparison -> and_\n     | comparison\n?comparison: sum (COMP_OP sum)?\n?sum: sum ADD_OP term         -> binop\n    | term\n?term: term MUL_OP factor     -> binop\n     | factor\n?factor: \"-\" factor           -> neg\n       | atom\n?atom: NUMBER                 -> number\n     | STRING                 -> string\n     | NAME                   -> var\n     | \"(\" expr \")\"\n     | \"[\" [_list{expr}] \"]\"  -> list\n     | boolean\n     | NAME~2..3 \"!\"           -> words\n\n!boolean: \"true\" | \"false\"\n\nCOMP_OP: \"==\" | \"!=\" | \"<=\" | \">=\" | \"<\" | \">\"\nADD_OP: \"+\" | \"-\"\nMUL_OP: \"*\" | \"/\" | \"%\"\nNAME.-1: /[a-z_][a-z0-9_]*/i\nNUMBER: DIGIT+ (\".\" DIGIT+)?\nSTRING: \"'\" /[^']*/ \"'\"\nDIGIT: \"0\"..\"9\"\nCOMMENT: /#[^\\n]*/\n\n%import common.WS\n%ignore WS\n%ignore COMMENT\n"
    },
    {
     "input": "// Lark's examples/advanced/dynamic_complete.py: JSON with \"_\" as the quote character.\n%import common.SIGNED_NUMBER\n%import common.WS_INLINE\n%import common.NEWLINE\n%ignore WS_INLINE\n\n?start: value\n\n?value: object\n      | array\n      | string\n      | SIGNED_NUMBER      -> number\n      | \"true\"             -> true\n      | \"false\"            -> false\n      | \"null\"             -> null\n\narray  : \"[\" (value (\",\" value)*)? \"]\"\nobject : \"{\" (pair (\",\" pair)*)? \"}\"\npair   : string \":\" value\n\nstring: STRING\nSTRING : ESCAPED_STRING\n\nESCAPED_STRING: QUOTE_CHAR _STRING_ESC_INNER QUOTE_CHAR\nQUOTE_CHAR: \"_\"\n\n_STRING_INNER: /.*/\n_STRING_ESC_INNER: _STRING_INNER /(?<!\\\\)(\\\\\\\\)*?/\n"
    },
