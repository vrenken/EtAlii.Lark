<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Fixtures\**\*.lark" />
    <AdditionalFiles Include="Generator\Grammars\*.lark" />
    <!-- The language-neutral conformance suite, shared with the Rust and TypeScript packages. -->
    <None Include="..\..\..\conformance\cases\*.json" Link="conformance\cases\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\conformance\known-failures\*.txt" Link="conformance\known-failures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The example of docs/typed-visitor.md is compiled and tested here. -->
    <Compile Include="..\..\docs\examples\PurchaseOrders\*.cs" Link="Examples\PurchaseOrders\%(Filename)%(Extension)" />
    <AdditionalFiles Include="..\..\docs\examples\PurchaseOrders\*.lark" Link="Examples\PurchaseOrders\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EtAlii.Lark\EtAlii.Lark.csproj" />
    <ProjectReference Include="..\..\src\EtAlii.Lark.Generators\EtAlii.Lark.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="true" />
  </ItemGroup>

</Project>
